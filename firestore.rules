
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read/write their own profile, but only read others'
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    
    // Users can read/write their own notifications
    match /users/{userId}/notifications/{notificationId} {
        allow read, write: if request.auth.uid == userId;
    }

    // Chat Rooms can be read and updated only by participants.
    match /chatRooms/{roomId} {
      allow get, list: if request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth.uid in resource.data.participants;

      // Messages can be read and created only by participants of the chat room.
      match /messages/{messageId} {
        allow read, create: if get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants.hasAny([request.auth.uid]);
        // Deletion is denied to preserve chat history integrity in this model.
        allow delete: if false; 
      }
    }

    // Suggestions can be read by anyone, but only created/modified/deleted by the owner
    match /suggestions/{suggestionId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
      
      match /comments/{commentId} {
        allow read, create: if request.auth != null;
      }
    }
    
    // Assignments can be read by anyone, but only created/modified/deleted by the owner
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read, create: if request.auth != null;
      }
    }

    // Community chat messages can be read by anyone, but only deleted by the owner
    match /messages/{messageId} {
        allow read, create: if request.auth != null;
        allow delete: if request.auth.uid == resource.data.userId;
    }

    // Game scores can be created by any authenticated user
    match /games/{gameId}/scores/{scoreId} {
        allow read, create: if request.auth != null;
    }
  }
}
