
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Check the user's role from their document in the 'users' collection.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/write their own profile. Admins can update roles.
    match /users/{userId} {
      allow read, create: if isSignedIn();
      // Allow user to update their own profile, but not their role.
      allow update: if isOwner(userId) && !(request.resource.data.role != resource.data.role);
      // Allow admin to update any user profile, including their role.
      allow update: if isAdmin(); 
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Suggestions can be read by anyone, but only created/managed by their owner or an admin.
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Assignments can be read by anyone, but only created/managed by their owner or an admin.
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // Any signed-in user can send messages, but can only delete their own. Admins can delete any message.
    match /messages/{messageId} {
      allow read, create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Any signed-in user can submit a music request. Admins can manage them.
    match /musicRequests/{requestId} {
      allow read, create: if isSignedIn();
      allow delete: if isAdmin(); 
    }
    
    // Any signed-in user can submit a game score. Scores cannot be updated or deleted by users.
    match /games/{gameId}/scores/{scoreId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
