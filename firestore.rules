/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for data stored under the `/users/{userId}` path.
 * Users can only read and write their own user profiles and associated data (suggestions, assignments).
 * Suggestions and Assignments are world readable by any authenticated user.
 * Subjects, stored in a top-level collection, are publicly readable but not writable by end-users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /suggestions/{suggestionId}: Stores user-created suggestions.
 * - /assignments/{assignmentId}: Stores user-submitted assignments.
 * - /subjects/{subjectId}: Stores subject categories.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent information harvesting.
 * - Suggestions and assignments are publicly readable to all authenticated users.
 * - Subjects are publicly readable to facilitate data filtering and selection but not writable.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their profile with matching userId.
     * @allow (get) - Authenticated user retrieves their own profile.
     * @allow (update) - Authenticated user updates their own profile.
     * @allow (delete) - Authenticated user deletes their own profile.
     * @deny (create) - Authenticated user attempts to create a profile for another user.
     * @deny (get) - Authenticated user attempts to retrieve another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows authenticated users to read suggestions. Write access is restricted to the owner.
     * @path /suggestions/{suggestionId}
     * @allow (read) - Authenticated user can read any suggestion.
     * @allow (create) - Authenticated user creates a suggestion with matching userId.
     * @allow (update, delete) - The user who created the suggestion can update or delete it.
     * @principle Allows public read access for authenticated users, with ownership-based writes.
     */
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /**
     * @description Allows authenticated users to read assignments. Write access is restricted to the owner.
     * @path /assignments/{assignmentId}
     * @allow (read) - Authenticated user can read any assignment.
     * @allow (create) - Authenticated user creates an assignment with matching userId.
     * @allow (update, delete) - The user who created the assignment can update or delete it.
     * @principle Allows public read access for authenticated users, with ownership-based writes.
     */
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /**
     * @description Allows public read access to subjects. Write access is not permitted for end-users.
     * @path /subjects/{subjectId}
     * @allow (read) - Any user can retrieve or list subjects.
     * @deny (write) - No user can create, update, or delete a subject.
     * @principle Allows public read access while restricting writes.
     */
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
