
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth.token.email == 'harshroop100@gmail.com';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin(); // Admin can delete users
    }

    // Suggestions, Assignments, and Messages
    match /{collection}/{docId} {
      // Allow read for any authenticated user
      allow get, list: if isAuthenticated();

      // Allow create for any authenticated user
      allow create: if isAuthenticated();

      // Allow update only by owner or admin
      allow update: if isAdmin() || (isAuthenticated() && isOwner(resource.data.userId));

      // Allow delete only by owner or admin
      allow delete: if isAdmin() || (isAuthenticated() && isOwner(resource.data.userId));
    }
  }
}
