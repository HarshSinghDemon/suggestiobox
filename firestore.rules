/**
 * @fileoverview Firestore Security Rules for StudyShare Central.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, ensuring that users can only access and modify data associated with their own accounts.
 *
 * Data Structure:
 * All user-specific data is nested under /users/{userId}, including suggestions and assignments.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own suggestions and assignments.
 * - Listing of user documents is allowed only for the owner of the account.
 *
 * Denormalization for Authorization:
 * The 'userId' field is denormalized into both the 'suggestions' and 'assignments' collections to allow for simple and efficient ownership checks without additional reads. This enables rules to validate ownership (request.auth.uid == resource.data.userId) without needing to perform expensive `get()` operations to retrieve user data.
 *
 * Structural Segregation:
 * User-specific data (suggestions, assignments) are stored under the /users/{userId} path. This segregation ensures that all documents within a given user's subcollections share the same security requirements (i.e., only the user can create/modify/delete them).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the /users/{userId} collection, ensuring only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their profile if request.auth.uid == 'user_abc'.
     * @allow (get, list) - User with UID 'user_abc' can read their profile.
     * @deny (create) - User with UID 'user_xyz' cannot create a profile with ID 'user_abc'.
     * @deny (update, delete) - User with UID 'user_xyz' cannot modify or delete the 'user_abc' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId); //Enforce immutability of id, the authorization field
      allow delete: if isOwner(userId);
    }

    /**
     * @description Protects the /users/{userId}/suggestions/{suggestionId} collection, ensuring only the user can manage their own suggestions.
     * @path /users/{userId}/suggestions/{suggestionId}
     * @allow (create) - User with UID 'user_abc' can create a suggestion under their profile if request.auth.uid == 'user_abc' and request.resource.data.userId == 'user_abc'.
     * @allow (get, list) - User with UID 'user_abc' can read and list suggestions under their profile.
     * @deny (create) - User with UID 'user_xyz' cannot create a suggestion under 'user_abc's profile.
     * @deny (update, delete) - User with UID 'user_xyz' cannot modify or delete suggestions under 'user_abc's profile.
     * @principle Enforces document ownership and validates relational integrity for writes.
     */
    match /users/{userId}/suggestions/{suggestionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && (request.resource.data.userId == userId);
      allow update: if isOwner(userId) && (request.resource.data.userId == resource.data.userId); //Enforce immutability of userId, the authorization field
      allow delete: if isOwner(userId);
    }

    /**
     * @description Protects the /users/{userId}/assignments/{assignmentId} collection, ensuring only the user can manage their own assignments.
     * @path /users/{userId}/assignments/{assignmentId}
     * @allow (create) - User with UID 'user_abc' can create an assignment under their profile if request.auth.uid == 'user_abc' and request.resource.data.userId == 'user_abc'.
     * @allow (get, list) - User with UID 'user_abc' can read and list assignments under their profile.
     * @deny (create) - User with UID 'user_xyz' cannot create an assignment under 'user_abc's profile.
     * @deny (update, delete) - User with UID 'user_xyz' cannot modify or delete assignments under 'user_abc's profile.
     * @principle Enforces document ownership and validates relational integrity for writes.
     */
    match /users/{userId}/assignments/{assignmentId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && (request.resource.data.userId == userId);
      allow update: if isOwner(userId) && (request.resource.data.userId == resource.data.userId); //Enforce immutability of userId, the authorization field
      allow delete: if isOwner(userId);
    }
  }
}