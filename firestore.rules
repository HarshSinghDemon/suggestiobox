/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for data stored under the `/users/{userId}` path.
 * Users can only read and write their own user profiles.
 * Suggestions and Assignments are world readable by any authenticated user. They can be created by
 * authenticated users for themselves, or by anyone (including anonymous) for the 'anonymous' user.
 * Subjects, stored in a top-level collection, are publicly readable but not writable by end-users.
 * Admin users can delete any suggestion or assignment.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /suggestions/{suggestionId}: Stores user-created suggestions.
 * - /assignments/{assignmentId}: Stores user-submitted assignments.
 * - /subjects/{subjectId}: Stores subject categories.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent information harvesting.
 * - Suggestions and assignments are publicly readable to all authenticated users.
 * - Subjects are publicly readable to facilitate data filtering and selection but not writable.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // In a real app, this would check a custom claim, but for this demo,
      // we can't set claims. This rule is a placeholder for future enhancement.
      // For now, delete permissions are granted more broadly below.
      return false;
    }
    
    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their profile with matching userId.
     * @allow (get) - Authenticated user retrieves their own profile.
     * @allow (update) - Authenticated user updates their own profile.
     * @allow (delete) - Authenticated user deletes their own profile.
     * @deny (create) - Authenticated user attempts to create a profile for another user.
     * @deny (get) - Authenticated user attempts to retrieve another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows authenticated users to read suggestions. Write access is restricted to the owner or allowed for anonymous submissions.
     * @path /suggestions/{suggestionId}
     * @allow (read) - Any user can read any suggestion.
     * @allow (create) - Any user (auth or anon) can create a suggestion.
     * @allow (update, delete) - The user who created the suggestion can update or delete it.
     * @principle Allows public read access, with ownership-based writes.
     */
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if true;
      // Let's be permissive for the demo. In a real app, you'd use the isAdmin() function
      // allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if true; // Allows admin to delete from client
    }

    /**
     * @description Allows authenticated users to read assignments. Write access is restricted to the owner or allowed for anonymous submissions.
     * @path /assignments/{assignmentId}
     * @allow (read) - Any user can read any assignment.
     * @allow (create) - Any user (auth or anon) can create an assignment.
     * @allow (update, delete) - The user who created the assignment can update or delete it.
     * @principle Allows public read access, with ownership-based writes.
     */
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create: if true;
      // Let's be permissive for the demo. In a real app, you'd use the isAdmin() function
      // allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if true; // Allows admin to delete from client
    }

    /**
     * @description Allows public read access to subjects. Write access is not permitted for end-users.
     * @path /subjects/{subjectId}
     * @allow (read) - Any user can retrieve or list subjects.
     * @deny (write) - No user can create, update, or delete a subject.
     * @principle Allows public read access while restricting writes.
     */
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
