/**
 * @fileoverview Firestore Security Rules for StudyShare Central.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for writes and deletes,
 * but allows public read access for browsing.
 *
 * Data Structure:
 * All suggestions and assignments are stored in root-level collections.
 *
 * Key Security Decisions:
 * - Any authenticated user can read (get, list) suggestions and assignments.
 * - Users can only create suggestions and assignments for themselves (uid must match).
 * - Users can only update or delete their own suggestions and assignments.
 * - User profile documents (/users/{userId}) are private to the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile data. Only the owner can access their own document.
     */
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Secures the 'suggestions' collection.
     * Allows public reads but restricts writes/deletes to owners.
     */
    match /suggestions/{suggestionId} {
      // Any authenticated user can read suggestions.
      allow get, list: if request.auth != null;

      // Only the owner can create a suggestion, and the userId must be correct.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // Only the owner can update or delete their suggestion.
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Secures the 'assignments' collection.
     * Allows public reads but restricts writes/deletes to owners.
     */
    match /assignments/{assignmentId} {
      // Any authenticated user can read assignments.
      allow get, list: if request.auth != null;

      // Only the owner can create an assignment, and the userId must be correct.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // Only the owner can update or delete their assignment.
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
