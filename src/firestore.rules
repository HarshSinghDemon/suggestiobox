
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isParticipant(roomId) {
      return request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
    }
    
    function isGroupParticipant(groupId) {
      return request.auth.uid in get(/databases/$(database)/documents/groupChatRooms/$(groupId)).data.participants;
    }

    // Users can read/write their own profile, but only read others'
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    
    // Users can read/write their own notifications
    match /users/{userId}/notifications/{notificationId} {
        allow read, write: if request.auth.uid == userId;
    }

    // Chat Rooms can be read only by participants.
    match /chatRooms/{roomId} {
      allow get: if isParticipant(roomId);
      allow list: if false; // Users should not be able to list all chat rooms.
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if isParticipant(roomId);

      // Messages can be read and created only by participants of the chat room.
      match /messages/{messageId} {
        allow read, create, update: if isParticipant(roomId);
        // Deletion is denied to preserve chat history integrity in this model.
        allow delete: if false; 
      }
    }
    
    match /groupChatRooms/{groupId} {
        allow get: if isGroupParticipant(groupId);
        allow list: if false;
        allow create: if request.auth != null && request.auth.uid in request.resource.data.participants && request.auth.uid == request.resource.data.createdBy;
        allow update: if isGroupParticipant(groupId);

        match /messages/{messageId} {
            allow read, create: if isGroupParticipant(groupId);
            allow update, delete: if isGroupParticipant(groupId) && (request.auth.uid == resource.data.senderId || request.auth.uid in resource.data.admins);
        }
    }

    // Suggestions can be read by anyone, but only created/modified/deleted by the owner
    // Votes can be updated by any authenticated user
    match /suggestions/{suggestionId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId || (request.auth.uid != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']));
      allow delete: if request.auth.uid == resource.data.userId;
      
      match /comments/{commentId} {
        allow read, create: if request.auth != null;
      }
    }
    
    // Assignments can be read by anyone, but only created/modified/deleted by the owner
    // Votes can be updated by any authenticated user
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId || (request.auth.uid != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']));
      allow delete: if request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read, create: if request.auth != null;
      }
    }

    // Community chat messages can be read by anyone, but only deleted by the owner
    match /messages/{messageId} {
        allow read, create: if request.auth != null;
        allow delete: if request.auth.uid == resource.data.userId;
    }

    // Game scores can be created by any authenticated user
    match /games/{gameId}/scores/{scoreId} {
        allow read, create: if request.auth != null;
    }
  }
}
