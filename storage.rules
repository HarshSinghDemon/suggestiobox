rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow anyone to write to the 'suggestions' and 'assignments' folders.
    match /suggestions/{userId}/{allPaths=**} {
      allow write: if true;
    }

    match /assignments/{userId}/{allPaths=**} {
      allow write: if true;
    }
  }
}
