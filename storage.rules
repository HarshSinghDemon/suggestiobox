rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default-deny rule
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read/write to their own folder in 'suggestions'
    match /suggestions/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read/write to their own folder in 'assignments'
    match /assignments/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
