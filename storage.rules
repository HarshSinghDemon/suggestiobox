rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the 'uploads' directory
    match /uploads/{allPaths=**} {
      // Allow read access to anyone, authenticated or not.
      allow read: if true;

      // Allow write (create, update, delete) access only if the user is authenticated.
      // This is a basic rule. You might want to add more specific checks, like file size or type.
      allow write: if request.auth != null;
    }
  }
}
